{
  "manifest_version": 3,
  "name": "Transmitter",
  "version": "1.3.0",
  "description": "A lightweight WebExtension for the Transmission BitTorrent client.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Transmitter"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
{
  "manifest_version": 3,
  "name": "Transmitter",
  "version": "1.4.0",
  "description": "A lightweight WebExtension for the Transmission BitTorrent client.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://*/transmission/web/*",
    "*://*/transmission/rpc*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Transmitter"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
